# ============================================================================
# AI 数字员工 (dsh) 系统配置模板
# ============================================================================
# 复制此文件为 cfg.yml 并根据实际环境修改:
#   cp cfg.yml.template cfg.yml
#
# 配置优先级: 环境变量 > cfg.yml > 默认值
#
# ⚠ 业务配置（接口地址、密钥等）请通过管理后台「模板管理」页面
#   上传 CSV 配置，不要写在 cfg.yml 中。
# ============================================================================

# ---- 服务配置 ----
server:
  # HTTP/HTTPS 监听端口
  port: 20002

  # 调试模式: true=开启(日志更详细), false=关闭(生产环境)
  debug: false

  # 对外提供服务的IP地址（用于构造回调 URL 等）
  self_ip: 192.168.1.102

  # 对外提供服务的端口（宿主机映射端口，用于构造回调 URL 等）
  self_port: 20003

# ---- 系统配置 ----
sys:
  # 同时执行的任务数上限
  max_concurrent_tasks: 5

  # 任务总数上限 (pending + processing)，超过后拒单返回 code=2002
  max_pending_tasks: 10

  # 运行时数据保留天数（task_logs + sessions 自动清理）
  retention_days: 30

# ---- LLM 配置 ----
# dsh 通过 DeepSeek Harness SDK 子进程调用 LLM。
# 协议: Anthropic-compatible Messages API（{base_url}/v1/messages）
# 认证: 通过 DEEPSEEK_API_KEY 环境变量传递
llm:
  # DeepSeek API 地址（留空则使用官方 API https://api.deepseek.com/anthropic）
  # 私有部署/代理: 填写网关地址，如 http://api-gate:16001
  # 需要使用支持 Anthropic Messages 协议的端点
  base_url: "http://192.168.1.104:16002"

  # DeepSeek API Key（对应环境变量 DEEPSEEK_API_KEY）
  auth_token: "sk-123456"

  # 默认模型（dsh 内置 catalog: deepseek-flash / deepseek-v4-pro）
  model: "deepseek-v4-pro"

  # API 超时（毫秒），单任务最长执行时间
  timeout_ms: 300000

  # 关闭非必要遥测（私有部署建议 true）
  disable_nonessential_traffic: true

  # dsh 运行时 home 目录（会话数据、存储等）。默认 data/dsh-home
  # dsh_home: ""
